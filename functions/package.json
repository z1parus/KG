{
  "name": "functions",
  "description": "Cloud Functions для приложения заказа еды (createOrder + уведомления)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "copy-domain": "node scripts/copy-domain.mjs",
    "build": "npm run copy-domain && tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "seed": "npm run copy-domain && node scripts/seed-firestore.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
