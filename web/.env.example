# Supabase (из панели проекта → Project Settings → API).
# Пока эти переменные не заданы, приложение работает на seed-данных (src/data/seed).
# Как только заданы URL и anon-ключ — composition root (src/lib/repositories.ts)
# автоматически переключается на Supabase.
#
# Скопируйте этот файл в .env.local и подставьте значения своего проекта.
# anon-ключ публичный (уходит в клиентский бандл) — это нормально. НЕ кладите сюда
# service_role-ключ: он только для Edge Function (секрет на стороне сервера).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
