# Firebase (веб-конфиг из консоли Firebase → Project settings → Your apps → Web app).
# Пока эти переменные не заданы, приложение работает на seed-данных (src/data/seed).
# Как только заданы apiKey и projectId — composition root (src/lib/repositories.ts)
# автоматически переключается на Firestore.
#
# Скопируйте этот файл в .env.local и подставьте значения своего проекта.
# ВАЖНО: не коммитьте .env.local и реальные ключи.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
