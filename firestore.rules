rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Витрина: публичное чтение, запись — только админ (через консоль/админку с ролью).
    match /restaurants/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /menu/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promocodes/{id} {
      allow read: if true;      // коды не секретны; применение проверяет сервер
      allow write: if isAdmin();
    }

    // Заказы: создавать может ТОЛЬКО Cloud Function createOrder (Admin SDK минует правила).
    // Клиенту прямая запись запрещена — это защита от подмены цены (roadmap, риск №4).
    match /orders/{id} {
      allow create: if false;
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();   // смену статуса делает ресторан
      allow delete: if false;
    }

    // Счётчик номеров заказов — только сервер (Admin SDK).
    match /counters/{id} {
      allow read, write: if false;
    }

    // Профили и адреса — только владелец или админ.
    match /users/{uid} {
      allow read, write: if isAdmin() || request.auth.uid == uid;
      match /addresses/{aid} {
        allow read, write: if isAdmin() || request.auth.uid == uid;
      }
    }
  }
}
